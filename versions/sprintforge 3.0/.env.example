# ==============================================================================
# SPRINTFORGE - ARQUIVO DE CONFIGURAÇÃO DE AMBIENTE (.env)
# Instruções de Conexão com o Banco de Dados PostgreSQL & Prisma
# ==============================================================================

# 1. URL DE CONEXÃO COM O POSTGRESQL (PRISMA ORM)
# Formato: postgresql://[USUARIO]:[SENHA]@[HOST]:[PORTA]/[NOME_DO_BANCO]?schema=[SCHEMA]
#
# Exemplos comuns:
# - Local Docker / PostgreSQL nativo:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sprintforge?schema=public"
#
# - Cloud SQL / Supabase / Neon / Render / AWS RDS:
#   DATABASE_URL="postgresql://neondb_owner:npg_secret@ep-cool-dawn-123456.us-east-2.aws.neon.tech/sprintforge?sslmode=require&schema=public"
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sprintforge?schema=public"

# 2. SEGURANÇA & AUTENTICAÇÃO JWT
# Chave secreta usada para assinar os tokens de autenticação dos usuários
JWT_SECRET="sprintforge_super_secure_jwt_secret_key_2026_prod"
JWT_EXPIRES_IN="7d"

# 3. CONFIGURAÇÕES DO SERVIDOR NODE.JS / EXPRESS
PORT=3000
NODE_ENV="development"

# 4. CORS ORIGIN (URL da aplicação frontend autorizada a consumir a API)
CORS_ORIGIN="http://localhost:3000"

# ==============================================================================
# COMANDOS ÚTEIS DO PRISMA:
# ------------------------------------------------------------------------------
# 1. Gerar o cliente Prisma em TypeScript:
#    npx prisma generate
#
# 2. Sincronizar o schema com o PostgreSQL (cria as tabelas automaticamente):
#    npx prisma db push
#
# 3. Criar uma migração versionada:
#    npx prisma migrate dev --name init
#
# 4. Abrir o Prisma Studio (interface visual para gerenciar o banco de dados):
#    npx prisma studio
#
# 5. Iniciar o servidor Backend Node.js:
#    npm run server
# ==============================================================================
